{
  "description": "Desktop notifications for Codex turn/question events (agent-notifications-go).",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^request_user_input$",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/bin/hook-wrapper.sh\" handle-hook PreToolUse",
            "command_windows": "\"%CLAUDE_PLUGIN_ROOT%\\bin\\agent-notifications-windows-amd64.exe\" handle-hook PreToolUse",
            "timeout": 30
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/bin/hook-wrapper.sh\" handle-hook Notification",
            "command_windows": "\"%CLAUDE_PLUGIN_ROOT%\\bin\\agent-notifications-windows-amd64.exe\" handle-hook Notification",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/bin/hook-wrapper.sh\" handle-hook Stop",
            "command_windows": "\"%CLAUDE_PLUGIN_ROOT%\\bin\\agent-notifications-windows-amd64.exe\" handle-hook Stop",
            "timeout": 30
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/bin/hook-wrapper.sh\" handle-hook SubagentStop",
            "command_windows": "\"%CLAUDE_PLUGIN_ROOT%\\bin\\agent-notifications-windows-amd64.exe\" handle-hook SubagentStop",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
