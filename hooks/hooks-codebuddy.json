{
  "description": "Desktop notifications for CodeBuddy Code task/question/plan/API-error events (agent-notifications-go).",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "ExitPlanMode|AskUserQuestion|EnterPlanMode",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CODEBUDDY_PLUGIN_ROOT}/bin/hook-wrapper.sh\" handle-hook PreToolUse --product codebuddy",
            "timeout": 30
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "permission_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CODEBUDDY_PLUGIN_ROOT}/bin/hook-wrapper.sh\" handle-hook Notification --product codebuddy",
            "timeout": 30
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CODEBUDDY_PLUGIN_ROOT}/bin/hook-wrapper.sh\" handle-hook SessionStart --product codebuddy",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CODEBUDDY_PLUGIN_ROOT}/bin/hook-wrapper.sh\" handle-hook Stop --product codebuddy",
            "timeout": 30
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CODEBUDDY_PLUGIN_ROOT}/bin/hook-wrapper.sh\" handle-hook SubagentStop --product codebuddy",
            "timeout": 30
          }
        ]
      }
    ],
    "TeammateIdle": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CODEBUDDY_PLUGIN_ROOT}/bin/hook-wrapper.sh\" handle-hook TeammateIdle --product codebuddy",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
