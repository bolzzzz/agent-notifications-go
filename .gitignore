# macOS terminal-notifier (downloaded by install.sh for click-to-focus)
bin/terminal-notifier.app/

# macOS AgentNotifications.app (created by install.sh for notification icon)
bin/AgentNotifications.app/

# macOS AgentNotifier (built from swift-notifier/ or downloaded by install.sh)
bin/AgentNotifier.app/
swift-notifier/.build/
swift-notifier/AgentNotifier.app/

# Root binary (should be in bin/ instead)
/agent-notifications

# Test binaries
*.test
*.out

# E2E test fixtures (generated during tests)
bin/test_fixtures/
test_fixtures/

# Coverage
coverage.txt
coverage.html

