# Binaries - exclude all platform-specific binaries
# These are downloaded from GitHub Releases during setup
bin/agent-notifications-*
bin/*.exe
bin/*.dll
bin/*.so
bin/*.dylib

# Windows wrapper (created dynamically by install.sh)
bin/agent-notifications.bat

# Keep these scripts in git:
# - bin/agent-notifications (wrapper script for Unix)
# - bin/install.sh (installer script)

# Temporary build files
bin/test-build
bin/sound-preview
bin/sound-preview-*
bin/list-devices
bin/list-devices-*
bin/list-sounds
bin/list-sounds-*
